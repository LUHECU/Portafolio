---
interface Props {
    href: string;
}
const { href } = Astro.props;
---

<a 
    href={href}
    target="_blank"
    rel="noopener noreferer"
    class="
        rounded-full border
        dark:border-white
        dark:text-white/90
        text-zinc-900/90
        border-zinc-800 
        flex 
        justify-center 
        items-center 
        gap-x-2 p-3
        dark:bg-white/10
        bg-zinc-800/5
        hover:scale-110 
        dark:hover:bg-white/20
        hover:bg-zinc-800/20
        transition-discrete
    "
>
    <slot/>
</a>