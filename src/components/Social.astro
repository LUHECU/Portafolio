---
interface Props {
    href: string;
}
const { href } = Astro.props;
---

<a 
    href={href}
    target="_blank"
    rel="noopener noreferer"
    class="
        rounded-full border
        border-white flex 
        justify-center 
        items-center 
        gap-x-2 p-3
        bg-white/5
        hover:scale-110 
        hover:bg-white/10
        transition-discrete
    "
>
    <slot/>
</a>