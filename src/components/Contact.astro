---
import { getLangFromUrl } from '@i18n/utils';
import { useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex justify-center items-center text-gray-900 dark:text-gray-100 p-10">
    <form class="flex flex-col gap-4" action="https://formspree.io/f/mdkqpzow" method="post">
        <div class="flex justify-between gap-5 @max-sm:flex-col ">
            <div class="flex flex-col gap-1 hover:font-semibold hover:text-blue-500">
                <label for="name">{t("contact.name")}</label>
                <input class="rounded-2xl border p-1 w-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none hover:scale-102 hover:border-blue-500 text-gray-900 dark:text-gray-100 font-normal" type="text" id="name" name="name" required />
            </div>
            <div class="flex flex-col gap-1 hover:font-semibold hover:text-blue-500">
                <label for="email">{t("contact.email")}</label>
                <input class="rounded-2xl border p-1 w-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none hover:scale-102 hover:border-blue-500 text-gray-900 dark:text-gray-100 font-normal" type="email" id="email" name="email" required />
            </div>
        </div>
        <div class="flex flex-col gap-1 hover:font-semibold hover:text-blue-500">
            <label for="message">{t("contact.message")}</label>
            <textarea class="rounded-2xl border p-1 px-2 placeholder-gray-900/50 dark:placeholder-gray-100/50 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none hover:scale-102 hover:border-blue-500 text-gray-900 dark:text-gray-100 font-normal" id="message" name="message" rows="4" placeholder={t("contact.messagePlaceholder")} required />
        </div>
        <div class="flex justify-end items-center">
            <button class="rounded-full p-1 w-25 text-white hover:bg-zinc-400/90 hover:dark:bg-white/30 bg-blue-500 hover:scale-95" type="submit">{t("contact.send")}</button>
        </div>
    </form>
</div>