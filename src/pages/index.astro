---
import Badge from '../components/badge.astro';
import Layout from '../layouts/Layout.astro';
import LinkedInIcon from '../components/icons/LinkedIn.astro';
import GitHubIcon from '../components/icons/GitHub.astro';
import MailIcon from '../components/icons/Mail.astro';
import Social from '../components/Social.astro';
import Experience from '../components/Experience.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Briefcase from '../components/icons/Briefcase.astro';
---

<Layout title='Portafolio de Luis Hernández - Desarrollador y Programador Web Full Stack' description=''>
	<main class="mx-5">
		<SectionContainer class="pt-44 py-22">
			<h1 class="text-white text-5xl lg:text-2xl font-bold flex flex-row gap-x-4 pb-10">
				Hola!!, soy Luis
				<a 
					href="https://linkedin.com/in/luhecu"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center"
				>
					<Badge>Disponible para trabajar</Badge>
				</a>
			</h1>
			<h2 class="text-2xl text-wrap sm:text-left">
				<span>
					Junior Full Stack Developer.
				</span>
				<span class="text-yellow-100/90">
					Especializado en Desarrollo 
					Backend de REST API's y Base de Datos.
				</span> 
				<span class="text-red-100/90 ">
					De San José, Costa Rica 🇨🇷. 
				</span>
				<span class="opacity-80 ">
					Apasionado de las Tecnologías Emergentes,
					Bases de Datos e Inteligencia Artificial
				</span>
			</h2>

			<ul class="flex flex-row justify-start items-center gap-x-3 mt-10 @max-sm:flex-col">
				<li class="hover:mx-1">
					<Social href="https://linkedin.com/in/luhecu">
						<LinkedInIcon class="size-7"/>
						<span>LinkedIn</span>
					</Social>
				</li>
				<li class="hover:mx-1">
					<Social href="https://github.com/LUHECU">
						<GitHubIcon class="size-7"/>
						<span>GitHub</span>
					</Social>
				</li>
				<li class="hover:mx-4">
					<Social href="mailto:luis.m.hernandez.cruz@gmail.com">
						<MailIcon class="size-7"/>
						<span>luis.m.hernandez.cruz@gmail.com</span>
					</Social>
				</li>
			</ul>
		</SectionContainer>

		<SectionContainer id="experience">
			<h2 class="text-3xl text-white font-bold mb-4 flex flex-row items-center gap-x-3">
				<Briefcase class="size-9"/>
				Experiencia
			</h2>	
			<Experience/>
		</SectionContainer>
	</main>
	


</Layout>
