---
import Layout from '@layouts/Layout.astro';
import LinkedInIcon from '@components/icons/LinkedIn.astro';
import GitHubIcon from '@components/icons/GitHub.astro';
import MailIcon from '@components/icons/Mail.astro';
import Social from '@components/Social.astro';
import Experience from '@components/Experience.astro';
import SectionContainer from '@components/SectionContainer.astro';
import Briefcase from '@components/icons/Briefcase.astro';
import Badge from '@components/Badge.astro';
import { indexStyles } from '@styles/styles';
import { getLangFromUrl } from '~/i18n/utils';
import InboxStack from '~/components/icons/InboxStack.astro';
import EnvelopeIcon from '~/components/icons/EnvelopeIcon.astro';

const lang = getLangFromUrl(Astro.url);

---

<Layout title='Portafolio de Luis Hernández - Desarrollador y Programador Web Full Stack' description=''>
	<main class={indexStyles.main}>
		<SectionContainer id="top" class={indexStyles.sectionContainer}>
			<h1 class={indexStyles.h1AboutMe}>
				Hola!!, soy Luis
				<a 
					href="https://linkedin.com/in/luhecu"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center"
				>
					<Badge>Disponible para trabajar</Badge>
				</a>
			</h1>
			<h2 class={indexStyles.h2AboutMe}>
				<span class={indexStyles.span1AboutMe}>
					Desarrollador Full Stack
				</span>
				<span class={indexStyles.span2AboutMe}>
					Con conocimientos solidos en Desarrollo 
					Backend de REST API's y Base de Datos.
				</span> 
				<span class={indexStyles.span3AboutMe}>
					Apasionado de las Tecnologías Emergentes,
					Bases de Datos e Inteligencia Artificial y su desarrollo.
				</span>
			</h2>

			<ul class={indexStyles.socialUl}>
				<li class={indexStyles.socialLi1}>
					<Social href="https://linkedin.com/in/luhecu">
						<LinkedInIcon class={indexStyles.socialIcon}/>
						<span>LinkedIn</span>
					</Social>
				</li>
				<li class={indexStyles.socialLi2}>
					<Social href="https://github.com/LUHECU">
						<GitHubIcon class={indexStyles.socialIcon}/>
						<span>GitHub</span>
					</Social>
				</li>
				<li class={indexStyles.socialLi3}>
					<Social href="mailto:luis.m.hernandez.cruz@gmail.com">
						<MailIcon class={indexStyles.socialIcon}/>
						<span>luis.m.hernandez.cruz@gmail.com</span>
					</Social>
				</li>
			</ul>
		</SectionContainer>

		<SectionContainer id="experience">
			<h2 class={indexStyles.h2}>
				<Briefcase class={indexStyles.icon}/>
				Experiencia
			</h2>	
			<Experience lang="lang"/>
		</SectionContainer>

		<SectionContainer id="projects">
			<h2 class={indexStyles.h2}>
				<InboxStack class={indexStyles.icon}/>
				Proyectos
			</h2>
		</SectionContainer>

		<SectionContainer id="contact">
			<h2 class={indexStyles.h2}>
				<EnvelopeIcon class={indexStyles.icon}/>
				Contacto
			</h2>
		</SectionContainer>

	</main>	


</Layout>
